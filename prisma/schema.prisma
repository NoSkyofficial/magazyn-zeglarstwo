generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

/// A magazine issue shown in the KIOSK section.
/// Exactly one row should have `isCurrent = true` at a time.
model Issue {
  id          String   @id @default(cuid())
  /// Editorial label e.g. "9-10/2025"
  label       String
  /// Sequential number of the publication, e.g. 18
  number      Int
  year        Int
  coverImage  String
  shopUrl     String
  isCurrent   Boolean  @default(false)
  publishedAt DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([publishedAt])
}

/// One of the 9 TEMATYKA categories. Ordered by `order` ascending.
model Topic {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  image       String
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TeamMember {
  id        String    @id @default(cuid())
  name      String
  role      String
  group     TeamGroup
  photo     String?
  order     Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

/// Rich-text page bodies (MAGAZYN, CONTACT intro, etc.).
/// `contentJson` stores TipTap JSON — render with @tiptap/html.
model PageContent {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  contentJson String
  updatedAt   DateTime @updatedAt
}

model Distributor {
  id    String @id @default(cuid())
  name  String
  order Int    @default(0)
}

/// Single-row table (id is always "singleton").
model SiteSettings {
  id              String   @id @default("singleton")
  publisherName   String
  address         String
  phone           String
  email           String
  facebookUrl     String
  instagramUrl    String
  /// External link used by the KIOSK subscription button
  subscriptionUrl String
  shopBaseUrl     String
  updatedAt       DateTime @updatedAt
}

enum TeamGroup {
  STAFF
  CONTRIBUTOR
}
